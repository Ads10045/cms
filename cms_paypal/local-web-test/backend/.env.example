# Configuration Environnement
NODE_ENV=development # integration, recette, production
PORT=3001
SERVER_URL=http://localhost:3001

# Base de Données
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Sécurité & Réseau
# En production, mettre l'URL exacte : https://fembeauty.site
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
# OBLIGATOIRE — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Swagger (uniquement actif en NODE_ENV=development)
SWAGGER_USER=admin
SWAGGER_PASSWORD=

# Logs
LOG_LEVEL=info # debug, info, warn, error
