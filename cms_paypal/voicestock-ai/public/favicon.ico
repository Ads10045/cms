<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f62fe" />
      <stop offset="100%" stop-color="#002d9c" />
    </linearGradient>
    <linearGradient id="waveGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4589ff" />
      <stop offset="100%" stop-color="#1192e8" />
    </linearGradient>
    <linearGradient id="boxTop" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#d0e2ff" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#000000" flood-opacity="0.4"/>
    </filter>
  </defs>

  <!-- Base Badge -->
  <rect width="64" height="64" rx="15" fill="url(#bgGrad)" />
  <rect x="1" y="1" width="62" height="62" rx="14" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="1.5" />

  <!-- IBM Tech Accent Stripes -->
  <rect x="9" y="9" width="13" height="2.2" rx="1.1" fill="#a6c8ff" opacity="0.9" />
  <rect x="9" y="12.5" width="13" height="2.2" rx="1.1" fill="#a6c8ff" opacity="0.9" />

  <!-- Voice Waves (Left) -->
  <rect x="7" y="29" width="3" height="6" rx="1.5" fill="#33b1ff" opacity="0.7" />
  <rect x="12" y="24" width="3.5" height="16" rx="1.75" fill="#78a9ff" />

  <!-- Voice Waves (Right) -->
  <rect x="48.5" y="24" width="3.5" height="16" rx="1.75" fill="#78a9ff" />
  <rect x="54" y="29" width="3" height="6" rx="1.5" fill="#33b1ff" opacity="0.7" />

  <!-- 3D Warehouse Inventory Cube -->
  <g filter="url(#glow)">
    <!-- Top Face -->
    <path d="M 32 17 L 44 24 L 32 31 L 20 24 Z" fill="url(#boxTop)" />
    <!-- Left Face -->
    <path d="M 20 24 L 32 31 L 32 45 L 20 38 Z" fill="#78a9ff" />
    <!-- Right Face -->
    <path d="M 44 24 L 32 31 L 32 45 L 44 38 Z" fill="#0f62fe" />
    <!-- Center Crease -->
    <line x1="32" y1="31" x2="32" y2="45" stroke="rgba(0,0,0,0.2)" stroke-width="1" />
  </g>

  <!-- AI Pulse Beacon -->
  <circle cx="32" cy="52" r="3.2" fill="#24a148" />
  <circle cx="32" cy="52" r="5.5" fill="none" stroke="#24a148" stroke-width="1" opacity="0.6" />
</svg>
